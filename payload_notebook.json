      "subCategories": [
        {
          "id": "auth_basic",
          "name": "水平越权",
          "entries": [
            {
              "id": "auth-hori-01",
              "title": "ID 自增遍历",
              "payload": "user_id\u003d1\nuser_id\u003d2\nuser_id\u003d3\nid\u003d1\nid\u003d2\nuid\u003d1\nuid\u003d2"
