              "id": "auth-vert-01",
              "title": "权限等级修改",
              "payload": "role\u003duser → role\u003dadmin\nlevel\u003d1 → level\u003d0\nauth\u003d0 → auth\u003d1\nis_admin\u003d0 → is_admin\u003d1"
            },
            {
              "id": "auth-vert-02",
