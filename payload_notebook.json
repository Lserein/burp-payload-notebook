            },
            {
              "id": "auth-hori-03",
              "title": "Token/身份凭证替换",
              "payload": "token\u003d其他用户token        只用于垂直越权测试\nsession_id\u003d其他用户session 只用于垂直越权测试\nuid\u003d其他用户uid"
            },
            {
              "id": "auth-hori-04",
              "title": "手机号/邮箱越权",
