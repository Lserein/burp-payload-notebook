              "payload": "uid\u003d1234\nuid\u003d1234,\nuid\u003d1234,1235\nuid\u003d1234\u0026uid\u003d1235"
            },
            {
              "id": "6198e412-74ed-4fd3-8119-4f438280b5e3",
              "title": "参数值置空",
              "payload": "uid\u003d1234\nuid\u003d"
            },
            {
              "id": "a9f2845d-4d85-4690-8449-78079b5d85c5",
              "title": "id后面加json",
